# Contact form delivery — copy this file to `.env` and fill ONE of the two.
# With neither set, the form falls back to opening the visitor's mail client
# addressed to FORM_RECIPIENT in src/pages/Contact.jsx.

# Option 1 (recommended, free, no backend):
# Get a key at https://web3forms.com — enter omar2003.sameh@gmail.com,
# they email you an access key. Paste it here.
VITE_WEB3FORMS_KEY=

# Option 2: any endpoint that accepts a JSON POST
# (Formspree, Basin, your own serverless function).
VITE_CONTACT_ENDPOINT=
